# Copy to backend/.env and fill in. Never commit the real .env.

# --- Security (required in production) ---
# Dashboard password. Leave empty only for local development: the API is then open to anyone who can reach it.
APP_PASSWORD=
# Long random string that signs login tokens, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
TOKEN_TTL_HOURS=168
# Comma-separated dashboard URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# --- AWS Bedrock ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
# Only needed when the machine has no AWS profile / instance role (e.g. inside Docker)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Strategy (defaults chosen by the 22-year walk-forward research) ---
HOLD_MIN_DAYS=15
HOLD_MAX_DAYS=20
TARGET_ATR=3.5
STOP_ATR=2.5
AGENT_TOP_N=15
ML_TOP_PCT=98
BREADTH_MIN=0.5

# --- Runtime ---
# Run exactly one API process with the scheduler; set 0 on any extra replica
RUN_SCHEDULER=1
LOG_LEVEL=INFO
# STORAGE_DIR=/data
